OPENAI_API_KEY=sk-...
SUPABASE_URL=https://pjkqynjshfknsixiicme.supabase.co
SUPABASE_SERVICE_KEY=...
LANGCHAIN_API_KEY=...
LANGCHAIN_PROJECT=egypt-edu-agent
LANGCHAIN_TRACING_V2=true

# RAG textbooks (BGE-M3 default embeddings, 1024-dim → pgvector)
# RAG_EMBEDDING_BACKEND=bge_m3
# Local-first TOC (no cloud quotas): place <MyBook>.toc.json next to the PDF, or pass --toc-json / API toc_json_path.
# RAG_TOC_CLOUD=0                    # 1=Gemini/Groq/Vision ok for printed TOC; 0=OCR + rules + optional local LLM only
# RAG_TOC_LLM_URL=http://127.0.0.1:11434/v1   # Ollama OpenAI-compatible base (optional TOC structuring)
# RAG_TOC_LLM_MODEL=qwen2.5:7b
# RAG_TOC_LLM_TIMEOUT=120
# /rag/generate-quiz retrieval (latency): fast = one vector RPC, no FTS fusion
# RAG_QUIZ_FAST=1
# RAG_QUIZ_TOP_K=8               # passages returned after pool trim (3–20)
# RAG_QUIZ_VECTOR_POOL=28        # fetched rows cap in fast-path pool (before top_k slice)
# RAG_QUIZ_RERANK=0              # cross-encoder (slow); use with RAG_QUIZ_FAST=0 usually
# RAG_QUIZ_HYBRID=0              # 1 = vector+FTS fusion when RAG_QUIZ_FAST=0 (slower, stronger recall)

# Multiple OpenRouter-style keys (failover): comma/pipe-separated in OPENROUTER_API_KEY, or
# OPENROUTER_API_KEY_FALLBACKS=key2,key3  (same pattern: AGENTROUTER_API_KEY_FALLBACKS, etc.)
# RAG_HYBRID=1
# RAG_RERANK=1
# RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RAG_OCRMYPDF=auto
# RAG_OCR_LANGUAGE=ara+eng
# Severely corrupted PDFs (frag_max≥0.48): fast parallel Tesseract on ALL pages instead of slow ocrmypdf.
# Tune workers/DPI for your machine (0 = auto-detect CPU count, max 8).
# RAG_BULK_OCR_WORKERS=4
# RAG_BULK_OCR_DPI=150
# RAG_PAGE_OCR_MAX_PAGES=40   # cap for the selective (non-severe) per-page path
# To force full-book ocrmypdf --redo-ocr instead (very slow but highest quality):
# RAG_OCR_FORCE_SEVERE_ENABLED=1
# RAG_OCR_GLOBAL_ON_BAD_LAYER=1
# RAG_PDF_CONVERTER=pymupdf|auto|docling — pymupdf default (MOE PDFs); docling optional
# RAG_DOCLING_DEVICE=cpu|cuda — default cpu (avoid VRAM clash with BGE-M3 on same GPU)
# RAG_DOCLING_TIMEOUT_SEC=240
# RAG_SILENT_HTTPX=1
# RAG_SILENT_TF=1
# BGE_BATCH_SIZE=16
